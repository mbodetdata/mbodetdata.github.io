source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-sitemap"
  gem "jekyll-seo-tag"
end

# Windows/JRuby n'embarquent pas les données de fuseau horaire (zoneinfo).
# Nécessaire uniquement pour le build local — sans effet sur GitHub Pages (Linux).
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
